{
	"name": "simvyn-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/types",
		"packages/core",
		"packages/server",
		"packages/cli",
		"packages/dashboard",
		"packages/modules/*"
	],
	"scripts": {
		"dev": "npm run dev -w @simvyn/cli",
		"build": "npm run build --workspaces --if-present",
		"typecheck": "tsc --build",
		"lint": "biome check ."
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
