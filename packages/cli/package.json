{
	"name": "simvyn",
	"version": "1.0.1",
	"type": "module",
	"description": "Universal mobile device devtool — control iOS Simulators and Android Emulators from a single dashboard and CLI",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"simvyn": "./src/index.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src/",
		"dist/",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"keywords": [
		"simulator",
		"emulator",
		"ios",
		"android",
		"devtools",
		"simctl",
		"adb",
		"mobile"
	],
	"license": "MIT",
	"author": "Pranshu Chittora",
	"homepage": "https://github.com/pranshuchittora/simvyn#readme",
	"bugs": {
		"url": "https://github.com/pranshuchittora/simvyn/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/pranshuchittora/simvyn.git",
		"directory": "packages/cli"
	},
	"dependencies": {
		"@simvyn/core": "*",
		"@simvyn/server": "*",
		"@simvyn/types": "*",
		"commander": "^14",
		"open": "^10"
	}
}
