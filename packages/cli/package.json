{
	"name": "simvyn",
	"version": "2.7.0",
	"type": "module",
	"description": "Universal mobile device devtool — control iOS Simulators, Android Emulators, and real devices from a single dashboard and CLI",
	"main": "./dist/index.js",
	"bin": {
		"simvyn": "./dist/index.js"
	},
	"exports": {
		".": {
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"skills/",
		"extensions/",
		"prompts/",
		"docs/agents.md",
		"llms.txt",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"bundle": "tsdown"
	},
	"engines": {
		"node": "^22.14.0 || >=24.0.0"
	},
	"keywords": [
		"simulator",
		"emulator",
		"ios",
		"android",
		"devtools",
		"simctl",
		"devicectl",
		"adb",
		"mobile",
		"real-device",
		"usb",
		"ios-simulator",
		"android-emulator",
		"mobile-development",
		"mobile-testing",
		"cli",
		"ai-agents",
		"agent-skills",
		"pi-package",
		"pi",
		"pi-coding-agent"
	],
	"license": "MIT",
	"author": "Pranshu Chittora",
	"homepage": "https://github.com/pranshuchittora/simvyn#readme",
	"bugs": {
		"url": "https://github.com/pranshuchittora/simvyn/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pranshuchittora/simvyn.git",
		"directory": "packages/cli"
	},
	"dependencies": {
		"@fastify/multipart": "^10.1.1",
		"@fastify/static": "^10.1.3",
		"@fastify/websocket": "^11.3.0",
		"@tmcw/togeojson": "^7.1.2",
		"@xmldom/xmldom": "^0.9.12",
		"better-sqlite3": "^13.0.3",
		"boxen": "^8.0.1",
		"cfonts": "^3.3.1",
		"commander": "^15.0.0",
		"fastify": "^5.12.4",
		"fastify-plugin": "^6.0.0",
		"open": "^11.0.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		],
		"image": "https://raw.githubusercontent.com/pranshuchittora/simvyn/main/assets/banner.png"
	}
}
